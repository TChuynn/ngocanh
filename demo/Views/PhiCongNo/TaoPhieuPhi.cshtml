@model PhieuPhi
@{ ViewData["Title"] = "Tạo phiếu phí"; }
<h4>Tạo phiếu phí phòng</h4>
<form asp-action="TaoPhieuPhi" method="post" class="col-md-6">
    <div class="mb-3">
        <label class="form-label">Sinh viên</label>
        <select name="SinhVienId" class="form-select" required>
            <option value="">-- Chọn sinh viên --</option>
            @foreach (var sv in (List<SinhVien>)ViewBag.DanhSachSinhVien)
            {
                <option value="@sv.Id">@sv.MSSV - @sv.TaiKhoan?.HoTen</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Tháng/Năm</label>
        <input asp-for="ThangNam" class="form-control" placeholder="VD: 11/2026" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Số tiền phải đóng (đ)</label>
        <input asp-for="SoTienPhaiDong" type="number" min="0" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Hạn thanh toán</label>
        <input asp-for="HanThanhToan" type="date" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Tạo phiếu phí</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
</form>
