@model KTXManagement.Demo.Controllers.TaoSinhVienInput
@{ ViewData["Title"] = "Thêm sinh viên"; }
<h4>Thêm hồ sơ sinh viên mới</h4>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="TaoMoi" method="post" class="col-md-6">
    <div class="mb-3">
        <label class="form-label">Tên đăng nhập</label>
        <input asp-for="TenDangNhap" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Mật khẩu ban đầu</label>
        <input asp-for="MatKhau" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Họ tên</label>
        <input asp-for="HoTen" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">MSSV</label>
        <input asp-for="MSSV" class="form-control" required />
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Lớp</label>
            <input asp-for="Lop" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Khoa</label>
            <input asp-for="Khoa" class="form-control" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Giới tính</label>
            <select asp-for="GioiTinh" class="form-select" asp-items="Html.GetEnumSelectList<GioiTinh>()"></select>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Ngày sinh</label>
            <input asp-for="NgaySinh" type="date" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Quê quán</label>
            <input asp-for="QueQuan" class="form-control" />
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
</form>
