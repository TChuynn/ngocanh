@model List<PhanAnhSuCo>
@{ ViewData["Title"] = "Phản ánh của tôi"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>📢 Phản ánh / sự cố của tôi</h4>
    <a asp-action="Gui" class="btn btn-primary">+ Gửi phản ánh mới</a>
</div>
@if (!Model.Any())
{
    <p class="text-muted">Bạn chưa gửi phản ánh/sự cố nào.</p>
}
else
{
    @foreach (var pa in Model)
    {
        <div class="card mb-2">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <h6>@pa.TieuDe</h6>
                    <span class="badge text-bg-@(pa.TrangThai == TrangThaiPhanAnh.DaXuLy ? "success" : pa.TrangThai == TrangThaiPhanAnh.Moi ? "danger" : "warning")">@pa.TrangThai</span>
                </div>
                <p class="mb-1">@pa.NoiDung</p>
                <p class="small text-muted mb-0">Gửi ngày @pa.NgayGui.ToString("dd/MM/yyyy") — Loại: @pa.LoaiPhanAnh</p>
                @if (!string.IsNullOrWhiteSpace(pa.PhanHoi))
                {
                    <div class="alert alert-light border mt-2 mb-0"><b>Phản hồi:</b> @pa.PhanHoi</div>
                }
            </div>
        </div>
    }
}
