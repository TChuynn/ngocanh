@model ThongKeViewModel
@{ ViewData["Title"] = "Thống kê"; }
<h4 class="mb-3">📊 Thống kê tổng quan KTX</h4>

<div class="row">
    <div class="col-md-3">
        <div class="card text-bg-primary">
            <div class="card-body">
                <div class="fs-2">@Model.TyLeLapDay%</div>
                <div>Tỷ lệ lấp đầy (@Model.SoGiuongDaCoNguoi/@Model.TongSoGiuong giường)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-danger">
            <div class="card-body">
                <div class="fs-4">@Model.TongCongNo.ToString("N0")đ</div>
                <div>Tổng công nợ (@Model.SoSinhVienConNo SV còn nợ)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-warning">
            <div class="card-body">
                <div class="fs-2">@Model.SoPhanAnhMoi</div>
                <div>Phản ánh mới</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-secondary">
            <div class="card-body">
                <div class="fs-2">@Model.SoPhanAnhDangXuLy / @Model.SoPhanAnhDaXuLy</div>
                <div>Đang xử lý / Đã xử lý</div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4 shadow-sm border-primary-subtle">
    <div class="card-header bg-primary-subtle d-flex justify-content-between align-items-center">
        <span class="fw-bold text-primary">🤖 Tóm tắt phản ánh/sự cố theo nhóm vấn đề bằng AI</span>
        <a asp-controller="PhanAnh" asp-action="TomTatAI" class="btn btn-sm btn-primary">
            Xem báo cáo phân nhóm &amp; đề xuất chi tiết →
        </a>
    </div>
    <div class="card-body">
        <pre style="white-space: pre-wrap; font-family: inherit; line-height: 1.6;" class="mb-0 text-secondary">@Model.TomTatAI</pre>
    </div>
</div>
