@model ThongKeViewModel
@{ ViewData["Title"] = "Thống kê"; }
<h4 class="mb-3">📊 Thống kê tổng quan KTX</h4>

<div class="row">
    <div class="col-md-3">
        <div class="card text-bg-primary">
            <div class="card-body">
                <div class="fs-2">@Model.TyLeLapDay%</div>
                <div>Tỷ lệ lấp đầy (@Model.SoGiuongDaCoNguoi/@Model.TongSoGiuong giường)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-danger">
            <div class="card-body">
                <div class="fs-4">@Model.TongCongNo.ToString("N0")đ</div>
                <div>Tổng công nợ (@Model.SoSinhVienConNo SV còn nợ)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-warning">
            <div class="card-body">
                <div class="fs-2">@Model.SoPhanAnhMoi</div>
                <div>Phản ánh mới</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-secondary">
            <div class="card-body">
                <div class="fs-2">@Model.SoPhanAnhDangXuLy / @Model.SoPhanAnhDaXuLy</div>
                <div>Đang xử lý / Đã xử lý</div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">🤖 Tóm tắt phản ánh/sự cố bằng AI</div>
    <div class="card-body">
        <pre style="white-space: pre-wrap; font-family: inherit;">@Model.TomTatAI</pre>
    </div>
</div>
