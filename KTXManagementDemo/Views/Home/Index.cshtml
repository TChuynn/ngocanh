@{
    ViewData["Title"] = "Trang chủ";
    var vaiTro = ViewBag.VaiTro as string;
    var hoTen = ViewBag.HoTen as string;
}

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--ocean-900);">
            Xin chào, @hoTen 👋
        </h2>
        <p class="text-muted mb-0 small">Chào mừng bạn đến với Hệ thống Quản trị Ký túc xá thông minh KTX AI</p>
    </div>
    <div>
        <span class="badge badge-ocean px-3 py-2 fs-6">
            Vai trò: <b>@vaiTro</b>
        </span>
    </div>
</div>

@if (vaiTro == "QuanLyKTX")
{
    <!-- 4 THẺ THỐNG KÊ QUẢN LÝ KTX -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card stat-card-ocean">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-number">@ViewBag.SoPhong</div>
                        <div class="stat-label">Tổng số phòng</div>
                    </div>
                    <span class="fs-1 opacity-50">🏢</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card stat-card-teal">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-number">@ViewBag.SoGiuongTrong</div>
                        <div class="stat-label">Giường còn trống</div>
                    </div>
                    <span class="fs-1 opacity-50">🛏️</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card stat-card-amber">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-number">@ViewBag.ChoDuyet</div>
                        <div class="stat-label">Yêu cầu chờ duyệt</div>
                    </div>
                    <span class="fs-1 opacity-50">⏳</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card stat-card-coral">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-number">@ViewBag.PhanAnhMoi</div>
                        <div class="stat-label">Phản ánh / Sự cố mới</div>
                    </div>
                    <span class="fs-1 opacity-50">📢</span>
                </div>
            </div>
        </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="d-flex gap-2 flex-wrap mb-4">
        <a asp-controller="DangKyO" asp-action="Index" class="btn btn-primary">
            🛏️ Xử lý duyệt xếp phòng
        </a>
        <a asp-controller="PhanAnh" asp-action="Index" class="btn btn-outline-primary">
            📢 Quản lý phản ánh/sự cố
        </a>
        <a asp-controller="PhanAnh" asp-action="TomTatAI" class="btn btn-outline-primary">
            🤖 AI Tóm tắt sự cố theo nhóm
        </a>
        <a asp-controller="ThongKe" asp-action="Index" class="btn btn-outline-secondary">
            📊 Báo cáo thống kê
        </a>
    </div>
}
else if (vaiTro == "KeToan")
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card stat-card-coral">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-number fs-2">@(((decimal)ViewBag.TongCongNo).ToString("N0"))đ</div>
                        <div class="stat-label">Tổng công nợ hiện tại</div>
                    </div>
                    <span class="fs-1 opacity-50">💳</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card stat-card-amber">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-number">@ViewBag.SoSinhVienConNo</div>
                        <div class="stat-label">Sinh viên còn nợ phí</div>
                    </div>
                    <span class="fs-1 opacity-50">👥</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card stat-card-ocean">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-number">@ViewBag.PhieuChuaThanhToan</div>
                        <div class="stat-label">Phiếu phí chưa đóng đủ</div>
                    </div>
                    <span class="fs-1 opacity-50">📋</span>
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex gap-2 mb-4">
        <a asp-controller="PhiCongNo" asp-action="TaoPhieuPhi" class="btn btn-primary">➕ Tạo phiếu phí mới</a>
        <a asp-controller="PhiCongNo" asp-action="Index" class="btn btn-outline-primary">📋 Danh sách phiếu phí</a>
        <a asp-controller="PhiCongNo" asp-action="CongNo" class="btn btn-outline-secondary">💵 Quản lý công nợ</a>
    </div>
}
else if (vaiTro == "SinhVien")
{
    var sv = ViewBag.SinhVien as KTXManagement.Demo.Models.SinhVien;
    var phongHienTai = ViewBag.PhongHienTai as KTXManagement.Demo.Models.DangKyO;

    <div class="card shadow-sm border-0 mb-4 card-hover-lift">
        <div class="card-header-ocean p-3">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold fs-5">👤 Thông tin sinh viên nội trú</span>
                <span class="badge badge-ocean">MSSV: @sv?.MSSV</span>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-4 align-items-center">
                <div class="col-md-4 text-center border-end">
                    <div class="display-3 mb-2">🎓</div>
                    <h5 class="fw-bold mb-1">@sv?.TaiKhoan?.HoTen</h5>
                    <div class="text-muted small">Lớp: <b>@sv?.Lop</b> — Khoa: <b>@sv?.Khoa</b></div>
                    <div class="mt-2">
                        <span class="badge badge-ocean">Trạng thái: @sv?.TrangThaiO</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <h6 class="text-muted text-uppercase small fw-bold mb-2">Phòng ở hiện tại:</h6>
                    @if (phongHienTai?.Phong != null)
                    {
                        <div class="p-3 bg-light rounded border">
                            <div class="fs-4 fw-bold text-primary">Phòng @phongHienTai.Phong.SoPhong</div>
                            <div class="text-muted small mt-1">Giường: <b>@phongHienTai.Giuong?.SoGiuong</b></div>
                            <div class="text-muted small">Đơn giá: @phongHienTai.Phong.DonGiaThang.ToString("N0")đ/tháng</div>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 bg-light rounded border text-muted">
                            <div>Bạn chưa được xếp phòng.</div>
                            <div class="mt-2">
                                <a asp-controller="DangKyO" asp-action="GoiYPhong" class="btn btn-sm btn-primary">
                                    ✨ AI Gợi ý chọn phòng ngay
                                </a>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-md-4">
                    <h6 class="text-muted text-uppercase small fw-bold mb-2">Tình hình tài chính:</h6>
                    <div class="p-3 bg-light rounded border">
                        <div class="text-muted small">Công nợ hiện tại:</div>
                        <div class="fs-3 fw-bold @(sv?.CongNo?.TongNoHienTai > 0 ? "text-danger" : "text-success")">
                            @((sv?.CongNo?.TongNoHienTai ?? 0).ToString("N0"))đ
                        </div>
                        <div class="small mt-1">
                            @(sv?.CongNo?.TongNoHienTai > 0 ? "⚠️ Vui lòng liên hệ Kế toán để thanh toán" : "✅ Bạn đã hoàn thành nghĩa vụ phí")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap mb-4">
        <a asp-controller="DangKyO" asp-action="GoiYPhong" class="btn btn-primary">
            ✨ AI Gợi ý chọn phòng
        </a>
        <a asp-controller="DangKyO" asp-action="CuaToi" class="btn btn-outline-primary">
            🛏️ Đăng ký ở của tôi
        </a>
        <a asp-controller="PhiCongNo" asp-action="CuaToi" class="btn btn-outline-warning text-dark">
            💳 Phí phòng của tôi
        </a>
        <a asp-controller="PhanAnh" asp-action="Gui" class="btn btn-outline-danger">
            📢 Gửi phản ánh/sự cố
        </a>
    </div>
}

<!-- FEATURE HIGHLIGHTS: CÁC TÍNH NĂNG AI THÔNG MINH -->
<div class="row g-3">
    <div class="col-md-6">
        <div class="ai-feature-card h-100 p-4">
            <div class="d-flex align-items-center mb-2">
                <span class="fs-2 me-2">📊</span>
                <div>
                    <h5 class="mb-0 fw-bold" style="color: var(--ocean-900);">AI Tóm tắt sự cố theo nhóm vấn đề</h5>
                    <span class="badge bg-danger-subtle text-danger fw-semibold">Dành cho Quản lý KTX</span>
                </div>
            </div>
            <p class="text-muted small mt-2 mb-3">
                Tự động gom nhóm các phản ánh của sinh viên vào 5 nhóm trọng yếu (Điện, Nước, Cơ sở vật chất, An ninh, Mạng), đánh giá mức độ khẩn cấp và đề xuất giải pháp xử lý tức thời.
            </p>
            <a asp-controller="PhanAnh" asp-action="TomTatAI" class="btn btn-sm btn-outline-primary">
                Xem phân tích nhóm sự cố →
            </a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="ai-feature-card h-100 p-4">
            <div class="d-flex align-items-center mb-2">
                <span class="fs-2 me-2">🎯</span>
                <div>
                    <h5 class="mb-0 fw-bold" style="color: var(--ocean-900);">AI Gợi ý xếp phòng theo tiêu chí</h5>
                    <span class="badge bg-success-subtle text-success fw-semibold">Dành cho Sinh viên</span>
                </div>
            </div>
            <p class="text-muted small mt-2 mb-3">
                Thuật toán phân tích chỗ trống thực tế, tính toán điểm số phù hợp (Match Score %) dựa trên bạn cùng khoa/lớp, vị trí tầng, ngân sách và phong cách sống yên tĩnh hay đông vui.
            </p>
            <a asp-controller="DangKyO" asp-action="GoiYPhong" class="btn btn-sm btn-primary">
                Trải nghiệm gợi ý phòng →
            </a>
        </div>
    </div>
</div>
