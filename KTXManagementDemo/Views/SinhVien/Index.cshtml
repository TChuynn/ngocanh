@model List<SinhVien>
@{ ViewData["Title"] = "Hồ sơ sinh viên"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>🎓 Hồ sơ sinh viên nội trú</h4>
    <a asp-action="TaoMoi" class="btn btn-primary">+ Thêm sinh viên</a>
</div>
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>MSSV</th>
                <th>Họ tên</th>
                <th>Tài khoản</th>
                <th>Lớp / Khoa</th>
                <th>Giới tính</th>
                <th>Trạng thái ở</th>
                <th>Trạng thái TK</th>
                <th>Công nợ</th>
                <th class="text-end" style="min-width: 190px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sv in Model)
            {
                <tr>
                    <td><b>@sv.MSSV</b></td>
                    <td>@sv.TaiKhoan?.HoTen</td>
                    <td><code>@sv.TaiKhoan?.TenDangNhap</code></td>
                    <td>@sv.Lop <span class="text-muted small">(@sv.Khoa)</span></td>
                    <td>@sv.GioiTinh</td>
                    <td>
                        <span class="badge text-bg-@(sv.TrangThaiO == TrangThaiOKTX.DangO ? "success" : sv.TrangThaiO == TrangThaiOKTX.DaDangKy ? "warning" : "secondary")">
                            @sv.TrangThaiO
                        </span>
                    </td>
                    <td>
                        <span class="badge text-bg-@(sv.TaiKhoan?.TrangThai == TrangThaiTaiKhoan.HoatDong ? "light text-dark border" : "danger")">
                            @sv.TaiKhoan?.TrangThai
                        </span>
                    </td>
                    <td class="@(sv.CongNo?.TongNoHienTai > 0 ? "text-danger fw-bold" : "text-success")">
                        @((sv.CongNo?.TongNoHienTai ?? 0).ToString("N0"))đ
                    </td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <a asp-action="ChiTiet" asp-route-id="@sv.Id" class="btn btn-outline-primary" title="Xem chi tiết">Chi tiết</a>
                            <a asp-action="Sua" asp-route-id="@sv.Id" class="btn btn-outline-warning" title="Chỉnh sửa hồ sơ">Sửa</a>
                        </div>
                        <form asp-action="Xoa" asp-route-id="@sv.Id" method="post" class="d-inline ms-1" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sinh viên @sv.MSSV (@sv.TaiKhoan?.HoTen)? Toàn bộ dữ liệu liên quan sẽ được xóa an toàn.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa sinh viên">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
