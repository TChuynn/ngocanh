@model Tang
@{
    ViewData["Title"] = "Sửa thông tin tầng";
    var danhSachToaNha = ViewBag.DanhSachToaNha as List<ToaNha> ?? new();
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">✏️ Chỉnh sửa Tầng @Model.SoThuTu</h5>
            </div>
            <div class="card-body">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <form asp-action="SuaTang" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tòa nhà</label>
                        <select asp-for="ToaNhaId" class="form-select" required>
                            @foreach (var toa in danhSachToaNha)
                            {
                                <option value="@toa.Id" selected="@(toa.Id == Model.ToaNhaId ? "selected" : null)">@toa.TenToaNha</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số thứ tự tầng</label>
                        <input asp-for="SoThuTu" type="number" min="1" class="form-control" required />
                        <div class="form-text">Nhập số thứ tự tầng (VD: 1, 2, 3...)</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">💾 Lưu thay đổi</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
