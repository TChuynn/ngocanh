@model Giuong
@{
    ViewData["Title"] = "Sửa thông tin giường " + Model.SoGiuong;
    bool coSinhVien = Model.SinhVienId != null || Model.TrangThai == TrangThaiGiuong.DaCoNguoi;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">🛏️ Chỉnh sửa Giường @Model.SoGiuong</h5>
            </div>
            <div class="card-body">
                <div class="mb-3 p-2 bg-light rounded border">
                    <div><b>Phòng:</b> @Model.Phong?.SoPhong</div>
                    <div><b>Tình trạng:</b>
                        @if (coSinhVien)
                        {
                            <span class="badge bg-danger">Đã có người - MSSV: @Model.SinhVien?.MSSV (@Model.SinhVien?.TaiKhoan?.HoTen)</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Trống</span>
                        }
                    </div>
                </div>

                <form asp-action="SuaGiuong" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mã / Số giường</label>
                        <input name="soGiuong" class="form-control" value="@Model.SoGiuong" required />
                        <div class="form-text">VD: A101-01, B202-03...</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Trạng thái giường</label>
                        <select name="trangThai" class="form-select">
                            <option value="@TrangThaiGiuong.Trong" selected="@(Model.TrangThai == TrangThaiGiuong.Trong ? "selected" : null)">Trống</option>
                            <option value="@TrangThaiGiuong.DaCoNguoi" selected="@(Model.TrangThai == TrangThaiGiuong.DaCoNguoi ? "selected" : null)">Đã có người</option>
                        </select>
                        @if (coSinhVien)
                        {
                            <div class="form-text text-warning">
                                ⚠️ Giường hiện đang có sinh viên cư trú. Để chuyển giường về trạng thái trống, vui lòng thực hiện qua chức năng Trả phòng hoặc Chuyển phòng ở mục Đăng ký ở.
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">💾 Lưu thay đổi</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
