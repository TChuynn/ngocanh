@{
    var vaiTro = User.Identity?.IsAuthenticated == true ? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value : null;
    var hoTen = User.Identity?.IsAuthenticated == true ? User.GetHoTen() : null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KTX AI Smart Dormitory</title>
    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5.3 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css" />
    <!-- Site Custom Ocean Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- Deep Ocean Luxury Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand navbar-brand-custom" asp-controller="Home" asp-action="Index">
                <span>🏢 KTX AI</span>
                <span class="brand-badge">Smart Dorm</span>
            </a>
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (vaiTro == "QuanLyKTX")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="HaTang" asp-action="Index">🏢 Hạ tầng KTX</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="SinhVien" asp-action="Index">👥 Hồ sơ sinh viên</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="DangKyO" asp-action="Index">🛏️ Đăng ký ở</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="PhiCongNo" asp-action="Index">💰 Phí &amp; Công nợ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="PhanAnh" asp-action="Index">📢 Phản ánh/Sự cố</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="ThongKe" asp-action="Index">📊 Thống kê</a></li>
                    }
                    else if (vaiTro == "SinhVien")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="SinhVien" asp-action="HoSoCuaToi">👤 Hồ sơ của tôi</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="DangKyO" asp-action="GoiYPhong">✨ AI Gợi ý phòng</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="DangKyO" asp-action="CuaToi">🛏️ Đăng ký ở của tôi</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="PhiCongNo" asp-action="CuaToi">💳 Phí phòng</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="PhanAnh" asp-action="CuaToi">📢 Phản ánh của tôi</a></li>
                    }
                    else if (vaiTro == "KeToan")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="PhiCongNo" asp-action="Index">📋 Phiếu phí</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="PhiCongNo" asp-action="CongNo">💵 Quản lý công nợ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="PhiCongNo" asp-action="TaoPhieuPhi">➕ Tạo phiếu phí</a></li>
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item me-lg-2 mb-2 mb-lg-0">
                            <span class="user-badge-pill">
                                👤 @hoTen <span class="opacity-75">(@vaiTro)</span>
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm px-3">Đăng xuất</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-light btn-sm text-primary fw-bold px-3 shadow-sm" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Page Content -->
    <main class="main-content container py-2">
        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                <span class="fs-5 me-2">✅</span>
                <div>@TempData["ThongBao"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Loi"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                <span class="fs-5 me-2">⚠️</span>
                <div>@TempData["Loi"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <!-- Clean Light Footer -->
    <footer class="footer-custom">
        <div class="container text-center">
            <div class="fw-semibold text-dark">🏢 Hệ thống Quản lý Ký túc xá Tích hợp AI (Smart Dormitory)</div>
            <div class="text-muted small mt-1">Nền tảng quản trị hạ tầng, tự động hóa xếp phòng và tóm tắt sự cố thông minh</div>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
